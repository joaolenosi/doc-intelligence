# Banco
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=doc
POSTGRES_PASSWORD=doc
POSTGRES_DB=doc_intelligence

# Fila. Aceita bullmq ou postgres. Os dois adaptadores sao reais, e trocar
# aqui e a demonstracao de que a peca e trocavel. Ver ADR-004.
FILA_ADAPTADOR=bullmq
FILA_CONCORRENCIA=5

REDIS_HOST=localhost
REDIS_PORT=6379

# Extrator. Ver a secao do duble na especificacao.
# SUCESSO, BAIXA_CONFIANCA, FALHA_TRANSITORIA, TIMEOUT, LENTO
DUBLE_MODO=SUCESSO
EXTRATOR_TIMEOUT_MS=60000
EXTRATOR_MAX_TENTATIVAS=3

# Politica de confianca. Numeros de partida, sem dado real por tras.
CONFIANCA_LIMIAR_TIPO=0.80
CONFIANCA_LIMIAR_CAMPO=0.85

# Fronteira de autenticacao. Nao e seguranca de verdade, ver especificacao.
API_KEY=troque-esta-chave

UPLOAD_TAMANHO_MAXIMO_BYTES=26214400
ARMAZENAMENTO_DIRETORIO=./storage
