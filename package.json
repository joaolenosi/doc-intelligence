{
  "name": "doc-intelligence",
  "version": "0.1.0",
  "description": "Servico de inteligencia documental. Trilha A do desafio.",
  "private": true,
  "scripts": {
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infraestrutura/persistencia/typeorm/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infraestrutura/persistencia/typeorm/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/infraestrutura/persistencia/typeorm/data-source.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integracao": "jest --config jest.integracao.config.js",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "ts-node src/main.ts",
    "start:worker": "ts-node src/worker.ts",
    "start:api:prod": "node dist/src/main.js",
    "start:worker:prod": "node dist/src/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "bullmq": "^5.34.2",
    "ioredis": "^5.4.2",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
