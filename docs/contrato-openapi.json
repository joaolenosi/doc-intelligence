{
  "openapi": "3.0.0",
  "paths": {
    "/v1/documentos": {
      "post": {
        "description": "Responde na hora e devolve um identificador. O resultado nao vem aqui:\nconsulte `GET /v1/documentos/{id}` ate o estado sair de `RECEIVED` ou\n`PROCESSING`, a cada 2 a 5 segundos.\n\n- `201` no primeiro envio de um conteudo, `200` quando aquele hash ja existe.\n  O reenvio nao reprocessa e nao paga chamada nova, mas registra a submissao.\n  O corpo traz `jaExistia` para distinguir os dois sem olhar o status code.\n- O tipo sai dos bytes, e nunca do nome ou do `Content-Type`. Aceita JPEG,\n  PNG, HEIC, HEIF e PDF, ate 25 MB.\n\nTempo de processamento, retentativa e custo estao em `docs/especificacao.md`.",
        "operationId": "DocumentosController_enviar",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "description": "Fronteira de autenticacao entre sistemas internos, e nao seguranca de verdade. O valor preenchido e o padrao do docker-compose deste projeto; fora dele, troque a variavel API_KEY.",
            "required": true,
            "schema": {
              "type": "string",
              "default": "chave-de-desenvolvimento"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Opcional. Requisicao repetida por timeout de rede nao cria submissao nova. E diferente do reenvio do mesmo arquivo, que cria. Deixe vazio para nao usar.",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "X-Sistema-Origem",
            "in": "header",
            "description": "Qual sistema interno enviou, e por qual canal o documento chegou. Obrigatorio porque a unicidade da chave de idempotencia e do par sistema mais chave. Exemplos: crm-atendimento, portal-balcao.",
            "required": true,
            "schema": {
              "type": "string",
              "default": "crm-atendimento"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Ha arquivos ficticios prontos em `fixtures/`, incluindo casos recusados.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "arquivo"
                ],
                "properties": {
                  "arquivo": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG, PNG, HEIC, HEIF ou PDF, ate 25 MB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reenvio: o conteudo ja existia. Submissao registrada, documento nao reprocessado. `jaExistia` vem `true` e `estado` traz a situacao atual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeRecebimento"
                }
              }
            }
          },
          "201": {
            "description": "Primeiro envio deste conteudo. `jaExistia` vem `false`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeRecebimento"
                }
              }
            }
          },
          "400": {
            "description": "Campo arquivo ausente ou header obrigatorio faltando",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeErro"
                }
              }
            }
          },
          "401": {
            "description": "Chave de API ausente ou invalida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeErro"
                }
              }
            }
          },
          "413": {
            "description": "Arquivo acima de 25 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeErro"
                }
              }
            }
          },
          "415": {
            "description": "Conteudo nao aceito, decidido por inspecao dos bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeErro"
                }
              }
            }
          }
        },
        "summary": "Recebe um documento",
        "tags": [
          "documentos"
        ]
      }
    },
    "/v1/documentos/{id}": {
      "get": {
        "description": "Consulte ate o estado sair de `RECEIVED` ou `PROCESSING`. Campos so vem preenchidos em `PROCESSED` e `REVIEW_REQUIRED`.",
        "operationId": "DocumentosController_obter",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "description": "Fronteira de autenticacao entre sistemas internos, e nao seguranca de verdade. O valor preenchido e o padrao do docker-compose deste projeto; fora dele, troque a variavel API_KEY.",
            "required": true,
            "schema": {
              "type": "string",
              "default": "chave-de-desenvolvimento"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeConsulta"
                }
              }
            }
          },
          "404": {
            "description": "Documento inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeErro"
                }
              }
            }
          }
        },
        "summary": "Consulta um documento",
        "tags": [
          "documentos"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "SaudeController_verificar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaDeSaude"
                }
              }
            }
          }
        },
        "summary": "Verifica se o servico esta de pe e enxerga o banco",
        "tags": [
          "saude"
        ]
      }
    }
  },
  "info": {
    "title": "DOC Intelligence",
    "description": "Servico interno que recebe imagem ou PDF, classifica, extrai os campos do tipo\ne propoe um nome padronizado. O upload responde na hora e o resultado sai na\nconsulta.\n\nTodo exemplo aqui e ficticio e nenhum numero passa em validacao de digito.\n\nProjeto, decisoes e o que ficou de fora estao em `docs/` no repositorio.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "chave-de-api": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Fronteira de autenticacao entre sistemas internos. Nao e seguranca de verdade: o mecanismo real seria mTLS ou OAuth2 client credentials."
      }
    },
    "schemas": {
      "RespostaDeRecebimento": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 42,
            "description": "Identificador do documento"
          },
          "estado": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PROCESSING",
              "PROCESSED",
              "REVIEW_REQUIRED",
              "FAILED",
              "REJECTED"
            ],
            "example": "RECEIVED",
            "description": "Situacao no momento da resposta. O upload nao espera o modelo, entao aqui e sempre RECEIVED no primeiro envio."
          },
          "hashConteudo": {
            "type": "string",
            "example": "c2f0a4d1b8e6539a7c41d0b2e8f36a91d4c7b05e29a1f83b6d0c4e7a95b2f318",
            "description": "sha-256 do conteudo. E a identidade do documento."
          },
          "tipoMidia": {
            "type": "string",
            "example": "image/jpeg",
            "description": "Detectado por inspecao dos bytes, nunca o informado."
          },
          "tamanhoBytes": {
            "type": "number",
            "example": 2481003
          },
          "jaExistia": {
            "type": "boolean",
            "example": false,
            "description": "Falso no primeiro envio deste conteudo, verdadeiro quando ele ja existia. Sem este campo, primeiro envio e reenvio so se distinguiriam pelo status code, e quem le apenas o corpo nao saberia qual dos dois aconteceu."
          },
          "criadoEm": {
            "type": "string",
            "example": "2026-09-01T12:04:11.221Z"
          }
        },
        "required": [
          "id",
          "estado",
          "hashConteudo",
          "tipoMidia",
          "tamanhoBytes",
          "jaExistia",
          "criadoEm"
        ]
      },
      "RespostaDeErro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string",
            "example": "TIPO_NAO_SUPORTADO"
          },
          "mensagem": {
            "type": "string",
            "example": "Conteudo nao e JPEG, PNG, HEIC nem PDF"
          }
        },
        "required": [
          "erro",
          "mensagem"
        ]
      },
      "CampoDaResposta": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "nome"
          },
          "valor": {
            "type": "string",
            "example": "MARIA FICTICIA DE SOUZA",
            "description": "Dado pessoal. Nunca aparece em log."
          },
          "confianca": {
            "type": "number",
            "example": 0.96,
            "minimum": 0,
            "maximum": 1,
            "description": "Confianca daquele valor, e nao do documento."
          },
          "origem": {
            "type": "string",
            "example": "MODELO",
            "enum": [
              "MODELO",
              "CORRECAO_HUMANA"
            ]
          }
        },
        "required": [
          "nome",
          "valor",
          "confianca",
          "origem"
        ]
      },
      "SubmissoesDaResposta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 2,
            "description": "Quantas vezes esse conteudo chegou."
          },
          "canais": {
            "example": [
              "crm-atendimento",
              "portal-balcao"
            ],
            "description": "Sistemas por onde o documento chegou, sem repeticao.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nomeOriginalMaisRecente": {
            "type": "string",
            "example": "procuracao-registro-casa.pdf"
          }
        },
        "required": [
          "total",
          "canais",
          "nomeOriginalMaisRecente"
        ]
      },
      "ErroDoProcessamento": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "TIMEOUT"
          },
          "mensagem": {
            "type": "string",
            "example": "Extrator nao respondeu em 60000ms",
            "description": "Tecnica. Nunca conteudo do documento."
          }
        },
        "required": [
          "codigo"
        ]
      },
      "ProcessamentoDaResposta": {
        "type": "object",
        "properties": {
          "tentativas": {
            "type": "number",
            "example": 1,
            "description": "Quantas chamadas ao modelo esse documento ja custou."
          },
          "provedor": {
            "type": "object",
            "example": "duble",
            "nullable": true
          },
          "modelo": {
            "type": "object",
            "example": "duble-deterministico-1",
            "nullable": true
          },
          "versaoPrompt": {
            "type": "object",
            "example": "extracao-rg.v1",
            "nullable": true,
            "description": "Qual versao de prompt produziu o resultado. Serve para comparar depois de uma troca de modelo."
          },
          "erro": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/ErroDoProcessamento"
              }
            ]
          }
        },
        "required": [
          "tentativas"
        ]
      },
      "RespostaDeConsulta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 42
          },
          "estado": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PROCESSING",
              "PROCESSED",
              "REVIEW_REQUIRED",
              "FAILED",
              "REJECTED"
            ],
            "example": "PROCESSED"
          },
          "tipoDocumento": {
            "type": "object",
            "example": "RG",
            "nullable": true
          },
          "confiancaTipo": {
            "type": "object",
            "example": 0.94,
            "nullable": true,
            "minimum": 0,
            "maximum": 1
          },
          "nomePadronizado": {
            "type": "object",
            "example": "RG_MARIA_FICTICIA_DE_SOUZA_000000000_2026-09-01.jpg",
            "nullable": true,
            "description": "Proposta de nome. O servico nao renomeia nada: no disco o arquivo continua guardado pela chave de armazenamento."
          },
          "motivosRevisao": {
            "example": [
              "CONFIANCA_CAMPO_BAIXA:numero"
            ],
            "description": "Por que o documento parou para conferencia. Codigos e nomes de campo, nunca valores. Vazio quando o estado nao e REVIEW_REQUIRED.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "campos": {
            "description": "So vem preenchido em PROCESSED e REVIEW_REQUIRED.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampoDaResposta"
            }
          },
          "submissoes": {
            "$ref": "#/components/schemas/SubmissoesDaResposta"
          },
          "processamento": {
            "$ref": "#/components/schemas/ProcessamentoDaResposta"
          },
          "criadoEm": {
            "type": "string",
            "example": "2026-09-01T12:04:11.221Z"
          },
          "processadoEm": {
            "type": "object",
            "example": "2026-09-01T12:04:29.884Z",
            "nullable": true
          }
        },
        "required": [
          "id",
          "estado",
          "motivosRevisao",
          "campos",
          "submissoes",
          "processamento",
          "criadoEm"
        ]
      },
      "RespostaDeSaude": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "example": "ok"
          },
          "banco": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "estado",
          "banco"
        ]
      }
    }
  }
}
